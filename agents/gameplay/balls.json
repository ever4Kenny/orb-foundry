            "force": 350,
            "_note": "R6 磁极强化时 radius ×1.5 → 330"
          }
        }
      ],
      "intent": "奖励 peg 收割机，瞄准趋近奖励 peg 簇"
    },

    {
      "id": "glass",
      "name": "玻璃球",
      "tags": ["medium", "split"],
      "mass": 0.9,
      "bounce": 0.70,
      "friction": 0.08,
      "linear_damp": 0.10,
      "radius": 30,
      "color_hint": "#f4f1d4",
      "effects": [
        {
          "id": "glass_split",
          "trigger": "onPegHit",
          "type": "split",
          "params": {
            "hit_threshold": 6,
            "child_count": 2,
            "child_mass_ratio": 0.5,
            "child_bounce": 0.80,
            "child_lifetime_ms": 4000,
