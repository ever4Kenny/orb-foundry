  "ball_pouch": {
    "_doc": "球袋是“永久扩充”的概念，本局内不放回。每轮从剩余球袋随机抽 N 颗候选，玩家选 1 颗发射。",
    "initial_balls": [
      {"ball_id": "iron",    "count": 2},
      {"ball_id": "crystal", "count": 2},
      {"ball_id": "magnet",  "count": 1},
      {"ball_id": "glass",   "count": 1}
    ],
    "initial_total": 6,
    "draw_per_round_default": 3,
    "draw_per_round_with_R3": 4,
    "pick_per_draw": 1,
    "without_replacement": true,
    "_refill_note": "球袋耗尽后，停止抽球（轮次结束）；slot_right 的“回 1 球”补的是当前轮发球数 +1，不是球袋"
  },

  "round_launches": {
    "round_1": 4,
    "round_2": 5,
    "round_3": 5,
    "_note": "总发球数 14 颗 ≤ 球袋 6 颗 + 选 3 颗扩充 + 回血。需保证球袋至少能抽完 14 次的候选——所以 round_2 后“扩充球袋”是必须给的"
  },

  "reroll": {
    "enabled": true,
    "charges_per_run": 2,
    "behavior": "discard_current_3_candidates_redraw_from_same_pouch",
    "consume_pouch": false,
    "ui": "发射区下方圆形按钮，剩余次数右上角数字"
  }
