      "linear_damp": 0.05,
      "radius": 30,
      "color_hint": "#7fd9ff",
      "effects": [],
      "intent": "高弹跳混乱流，靠 combo 堆分，配 B5 镜面边墙"
    },

    {
      "id": "magnet",
      "name": "磁球",
      "tags": ["medium", "magnetic"],
      "mass": 1.0,
      "bounce": 0.65,
      "friction": 0.10,
      "linear_damp": 0.08,
      "radius": 32,
      "color_hint": "#c25cff",
      "effects": [
        {
          "id": "magnet_attract",
          "trigger": "onUpdate",
          "type": "attract_to_tag",
